# This env file uses @env-spec - see https://varlock.dev/env-spec for more info
# 
# @currentEnv=$APP_ENV
# @defaultRequired=infer @defaultSensitive=false
# @generateTypes(lang=ts, path=env.d.ts)
# ----------
# Load the plugin
# @plugin(@varlock/1password-plugin)
#
# Initialize the plugin - see below for more details on options
# @initOp(token=$OP_TOKEN, allowAppAuth=forEnv(development), account=github)
# ---

# Add a service account token config item (if applicable)
# @type=opServiceAccountToken @sensitive
OP_TOKEN=

# @type=enum(development, production, test)
NODE_ENV=

# @type=enum(development, preview, production, test)
APP_ENV=fallback($NODE_ENV, development)

# @type=string
ORG_NAME=

# octokit 
# @type=url
BASE_URL=https://api.github.com
# @type=url
COMPARE_BASE_URL=https://api.github.com
# @type=url
PROXY_URL=
# @type=number
PAGE_SIZE=10
# @type=number
EXTRA_PAGE_SIZE=50

# logger
# @type=boolean
VERBOSE=false

# auth 
# @sensitive @type=string
ACCESS_TOKEN=your_token_here 
# @sensitive @type=string
COMPARE_ACCESS_TOKEN=
# @type=string
APP_ID=
# @sensitive @type=string 
PRIVATE_KEY=
# @sensitive @type=string
PRIVATE_KEY_FILE=
# @type=number
APP_INSTALLATION_ID=

# rate limit check 
# @type=number
RATE_LIMIT_CHECK_INTERVAL=25

# retry - exponential backoff
# @type=number
RETRY_MAX_ATTEMPTS=3
# @type=number
RETRY_INITIAL_DELAY=1000
# @type=number
RETRY_MAX_DELAY=30000
# @type=number
RETRY_BACKOFF_FACTOR=2
# @type=number
RETRY_SUCCESS_THRESHOLD=5

# resume option
# @type=boolean
RESUME_FROM_LAST_SAVE=false

# repository list

# @type=string
REPO_LIST=

# custom properties
# @type=string
CUSTOM_PROPERTY_NAME=
# @type=string
CUSTOM_PROPERTY_VALUE=
# @type=boolean
CLEAR_CUSTOM_PROPERTY_VALUE=false

# @type=string
EXCLUDE_TEAMS=

# repository comparison
# @type=url
SOURCE_ORG_URL=
# @type=url
COMPARE_ORG_URL=

# auto-process missing repositories
# @type=boolean
AUTO_PROCESS_MISSING=false

# webhooks
# @type=boolean
ONLY_ACTIVE_WEBHOOKS=false
# @type=boolean
ONLY_ACTIVE_REPOS=false
# @type=boolean
ONLY_UNIQUE_BASE_URLS=false
# @type=boolean
ONLY_PUBLIC_PAGES=false