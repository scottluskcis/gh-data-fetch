# Normalize text files to LF in repo across all OSes
* text=auto eol=lf

# Windows scripts keep CRLF for compatibility
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Common binary file types
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.tar binary
*.tgz binary
*.7z binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
